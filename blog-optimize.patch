+            btn.textContent = '隐藏看板娘';
+            btn.onclick = function () {
+                localStorage.setItem('live2d-hidden', '1');
+                var w = document.querySelector('#live2d-widget, #live2dcanvas');
+                if (w) w.style.display = 'none';
+                btn.remove();
+            };
+            document.body.appendChild(btn);
+        })();
+    </script>
+
+</footer>
+{{- end -}}
\ No newline at end of file
diff --git a/layouts/partials/rss/item.html b/layouts/partials/rss/item.html
new file mode 100755
index 0000000..8ebe5a1
--- /dev/null
+++ b/layouts/partials/rss/item.html
@@ -0,0 +1,37 @@
+{{- $params := .Page.Params | merge .Site.Params.Page | merge (dict "author" .Site.Author.name) -}}
+<item>
+    <title>
+        {{- .Page.Title -}}
+    </title>
+    <link>
+        {{- .Page.Permalink -}}
+    </link>
+    <pubDate>
+        {{- .Page.Date.Format "Mon, 02 Jan 2006 15:04:05 -0700"  -}}
+    </pubDate>
+    <author>
+        {{- /* 修复 LoveIt 主题 bug：原模板用 .params.author（不存在的字段）导致 RSS 作者恒为“作者”；改用 $params.author 并回退到站点作者 */ -}}
+        {{- $params.author | default .Site.Author.name | default (T "author") -}}
+    </author>
+    <guid>
+        {{- .Page.Permalink -}}
+    </guid>
+    <description>
+        {{- "<![CDATA[" | safeHTML -}}
+        {{- with $params.featuredimage -}}
+            <div class="featured-image">
+                <img src="{{ . | relURL }}" referrerpolicy="no-referrer">
+            </div>
+        {{- end -}}
+        {{- $content := .Page.Description -}}
+        {{- if $params.rssFullText -}}
+            {{- $content = dict "Content" .Page.Content "Ruby" $params.ruby "Fraction" $params.fraction "Fontawesome" $params.fontawesome | partial "function/content.html" -}}
+        {{- else -}}
+            {{- with .Page.Summary -}}
+                {{- $content = dict "Content" . "Ruby" $params.ruby "Fraction" $params.fraction "Fontawesome" $params.fontawesome | partial "function/content.html" -}}
+            {{- end -}}
+        {{- end -}}
+        {{- $content | replaceRE `<figure[^>]*>.*</figure>` "" | replaceRE `<img[^>]*( /)?>` "" | safeHTML -}}
+        {{- "]]>" | safeHTML -}}
+    </description>
+</item>
\ No newline at end of file
diff --git a/layouts/shortcodes/mermaid.html b/layouts/shortcodes/mermaid.html
new file mode 100644
index 0000000..96efcec
--- /dev/null
+++ b/layouts/shortcodes/mermaid.html
@@ -0,0 +1,34 @@
+{{- /* 覆盖 LoveIt 主题的 mermaid shortcode。
+  原因：主题的 mermaid 依赖 shortcode 经 Scratch 把流程图内容传给模板的 window.config，
+  但在 Hugo 0.123 下 shortcode 的 Scratch 写不进模板，mermaid.js 不加载、内容也丢失，
+  导致所有 mermaid 图都是空 div。本覆盖改走直出方案：内容直接写进 div，
+  用 CDN 的 mermaid 8 渲染，不依赖主题的 Scratch 机制。 */ -}}
+{{- $content := trim .Inner "\n" -}}
+<div class="mermaid-direct">{{ $content }}</div>
+<style>.mermaid-direct{text-align:center;margin:1em 0}.mermaid-direct svg{max-width:100%}</style>
+<script>
+(function () {
+  function render() {
+    if (!window.mermaid) return;
+    try {
+      mermaid.initialize({ startOnLoad: false, theme: 'neutral', securityLevel: 'loose' });
+      var nodes = document.querySelectorAll('.mermaid-direct:not([data-processed])');
+      if (nodes.length) mermaid.init(undefined, nodes);
+    } catch (e) { console.error('mermaid render failed', e); }
+  }
+  if (window.mermaid) { render(); return; }
+  if (window.__mermaidDirectLoading) {
+    document.addEventListener('mermaidDirectReady', render);
+    return;
+  }
+  window.__mermaidDirectLoading = true;
+  var s = document.createElement('script');
+  s.src = 'https://cdn.jsdelivr.net/npm/mermaid@8.14.0/dist/mermaid.min.js';
+  s.onload = function () {
+    window.__mermaidDirectLoading = false;
+    document.dispatchEvent(new Event('mermaidDirectReady'));
+    render();
+  };
+  document.head.appendChild(s);
+})();
+</script>
